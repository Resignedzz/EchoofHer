<!-- TagCloud — 3D rotating tag cloud canvas -->
<div class="tc-container" id="tc-container">
  <canvas id="tc-canvas" class="tc-canvas"></canvas>
  <div class="tc-fallback" id="tc-fallback">
    <slot />
  </div>
</div>

<style is:inline>
.tc-container { position: relative; width: 100%; height: 450px; margin: 1rem 0 2rem; }
.tc-canvas { width: 100%; height: 100%; display: block; cursor: grab; }
.tc-canvas:active { cursor: grabbing; }
.tc-fallback { display: none; position: absolute; inset: 0; align-items: center; justify-content: center; overflow-y: auto; padding: 1rem; }
.tc-fallback.show { display: flex; flex-wrap: wrap; gap: 8px; align-content: flex-start; }
</style>

<script is:inline>
(function(){
  var canvas = document.getElementById('tc-canvas');
  var container = document.getElementById('tc-container');
  var fallback = document.getElementById('tc-fallback');
  if (!canvas || !container || !fallback) return;

  // Collect tags from fallback content
  var links = fallback.querySelectorAll('a');
  if (!links.length) { fallback.classList.add('show'); return; }

  var tags = [];
  for (var i = 0; i < links.length; i++) {
    var a = links[i];
    var href = a.getAttribute('href') || '#';
    var label = a.textContent.replace(/^\s+|\s+$/g, '');
    var count = parseInt(a.querySelector('span')?.textContent || '1', 10) || 1;
    var size = 13 + Math.min(count, 10) * 1.5;
    tags.push({ label: label, href: href, count: count, size: size });
  }

  if (!tags.length) { fallback.classList.add('show'); return; }

  // 3D sphere positions
  var R = 140;
  var cx = 0, cy = 0;
  var points = [];
  var n = tags.length;
  var phi = Math.PI * (3 - Math.sqrt(5)); // golden angle

  for (var i = 0; i < n; i++) {
    var y = 1 - (i / (n - 1)) * 2;
    var radius = Math.sqrt(1 - y * y);
    var theta = phi * i;
    points.push({
      x: Math.cos(theta) * radius * R,
      y: y * R,
      z: Math.sin(theta) * radius * R,
      tag: i,
    });
  }

  var ctx = canvas.getContext('2d');
  var rotY = 0, speed = 0.0015;
  var dragAngle = 0, dragging = false, lastX = 0;

  function resize() {
    var dpr = window.devicePixelRatio || 1;
    var w = container.clientWidth, h = container.clientHeight;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    canvas.style.width = w + 'px';
    canvas.style.height = h + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    cx = w / 2;
    cy = h / 2;
  }
  resize();
  window.addEventListener('resize', resize);

  canvas.addEventListener('pointerdown', function(e){
    dragging = true;
    lastX = e.clientX;
  });
  window.addEventListener('pointerup', function(){ dragging = false; });
  window.addEventListener('pointermove', function(e){
    if (!dragging) return;
    dragAngle += (e.clientX - lastX) * 0.005;
    lastX = e.clientX;
  });

  canvas.addEventListener('click', function(e){
    // Detect click on a tag
    var px = e.clientX, py = e.clientY;
    var r = canvas.getBoundingClientRect();
    var mx = px - r.left - cx;
    var my = py - r.top - cy;
    var minD = Infinity, bestIdx = -1;
    for (var i = 0; i < points.length; i++) {
      var p = points[i];
      var cosA = Math.cos(rotY + dragAngle), sinA = Math.sin(rotY + dragAngle);
      var rx = p.x * cosA - p.z * sinA;
      var rz = p.x * sinA + p.z * cosA;
      if (rz < 0) continue; // behind sphere
      var sx = cx + rx, sy = cy + p.y;
      var d = Math.sqrt((mx - rx) * (mx - rx) + (my - p.y) * (my - p.y));
      if (d < minD) { minD = d; bestIdx = i; }
    }
    if (bestIdx >= 0 && minD < 30) {
      window.location.href = tags[bestIdx].href;
    }
  });

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    rotY += speed;

    var cosA = Math.cos(rotY + dragAngle);
    var sinA = Math.sin(rotY + dragAngle);

    // Sort by depth
    var sorted = [];
    for (var i = 0; i < points.length; i++) {
      var p = points[i];
      var rz = p.x * sinA + p.z * cosA;
      sorted.push({ idx: i, p: p, rz: rz, rx: p.x * cosA - p.z * sinA });
    }
    sorted.sort(function(a, b){ return a.rz - b.rz; });

    for (var si = 0; si < sorted.length; si++) {
      var s = sorted[si];
      var t = tags[s.idx];
      var sx = cx + s.rx;
      var sy = cy + s.p.y;
      var scale = (s.rz + R) / (2 * R); // 0 (back) to 1 (front)
      var isLight = document.documentElement.classList.contains('dark') ? false : true;
      var cr = isLight ? '30' : '224', cg = isLight ? '30' : '224', cb = isLight ? '60' : '240';
      var alpha = 0.3 + scale * 0.7;
      var fontSize = t.size * (0.6 + scale * 0.4);

      ctx.save();
      ctx.font = Math.round(fontSize) + 'px "JetBrains Mono", monospace';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillStyle = 'rgba(' + cr + ',' + cg + ',' + cb + ',' + alpha.toFixed(2) + ')';
      ctx.fillText(t.label, sx, sy);
      ctx.restore();
    }

    requestAnimationFrame(draw);
  }

  draw();
})();
</script>
