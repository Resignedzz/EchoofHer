<div class="guest-comments" id="guest-comments">
  <div class="gc-header">
    <h3 class="gc-title">💬 访客留言</h3>
    <p class="gc-desc">无需登录，直接留言 👇</p>
  </div>

  <div class="gc-messages" id="gc-messages"></div>

  <form class="gc-form" id="gc-form">
    <input type="text" id="gc-name" class="gc-input" placeholder="你的昵称（选填）" maxlength="50" autocomplete="off" />
    <textarea id="gc-text" class="gc-textarea" placeholder="说点什么吧..." rows="3" maxlength="2000" required></textarea>
    <div class="gc-actions">
      <span class="gc-hint" id="gc-hint"></span>
      <button type="submit" class="gc-submit" id="gc-submit">发送</button>
    </div>
  </form>
</div>

<style is:inline>
.guest-comments {
  margin: 2rem 0;
  padding: 1.5rem;
  background: var(--glass-bg);
  backdrop-filter: blur(var(--glass-blur));
  -webkit-backdrop-filter: blur(var(--glass-blur));
  border: 1px solid var(--glass-border);
  border-radius: .75rem;
}
.gc-header { margin-bottom: 1.25rem; }
.gc-title { font-size: 14px; font-weight: 600; margin-bottom: 2px; }
.gc-desc { font-size: 12px; color: var(--text-muted); }
.gc-messages { margin-bottom: 1.25rem; max-height: 400px; overflow-y: auto; }
.gc-msg { padding: .75rem 0; border-bottom: 1px solid var(--border); }
.gc-msg:last-child { border-bottom: none; }
.gc-msg-header { display: flex; align-items: center; gap: .5rem; margin-bottom: .35rem; }
.gc-msg-avatar { width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; background: linear-gradient(135deg, var(--accent), var(--accent-secondary)); color: #fff; flex-shrink: 0; }
.gc-msg-name { font-size: 13px; font-weight: 600; }
.gc-msg-time { font-size: 11px; color: var(--text-muted); margin-left: auto; white-space: nowrap; }
.gc-msg-body { font-size: 13.5px; line-height: 1.65; color: var(--text); word-break: break-word; }
.gc-empty { font-size: 13px; color: var(--text-muted); text-align: center; padding: 1rem 0; }
.gc-form { display: flex; flex-direction: column; gap: .6rem; }
.gc-input, .gc-textarea {
  width: 100%;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: .5rem;
  padding: .55rem .75rem;
  font-size: 13px;
  font-family: inherit;
  color: var(--text);
  outline: none;
  transition: border-color .2s;
  box-sizing: border-box;
}
.gc-input:focus, .gc-textarea:focus { border-color: var(--accent); }
.gc-input::placeholder, .gc-textarea::placeholder { color: var(--text-muted); opacity: .6; }
.gc-textarea { resize: vertical; min-height: 64px; }
.gc-actions { display: flex; align-items: center; justify-content: space-between; }
.gc-hint { font-size: 11px; color: var(--text-muted); }
.gc-submit {
  padding: .45rem 1.2rem;
  background: var(--accent);
  color: var(--bg);
  border: none;
  border-radius: .4rem;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: opacity .2s;
}
.gc-submit:hover { opacity: .85; }
.gc-submit:disabled { opacity: .5; cursor: not-allowed; }
</style>

<script is:inline>
(function(){
  var slug = window.location.pathname.replace(/\/$/, '').split('/').pop() || 'home';
  var API = '/api/comments?slug=' + encodeURIComponent(slug);
  var messages = document.getElementById('gc-messages');
  var form = document.getElementById('gc-form');
  var textEl = document.getElementById('gc-text');
  var nameEl = document.getElementById('gc-name');
  var hintEl = document.getElementById('gc-hint');
  var submitBtn = document.getElementById('gc-submit');

  function loadComments() {
    fetch(API).then(function(r){ return r.json(); }).then(function(data){
      if (!data.comments || !data.comments.length) {
        messages.innerHTML = '<p class="gc-empty">还没有留言，来做第一个 💬</p>';
        return;
      }
      var html = '';
      for (var i = 0; i < data.comments.length; i++) {
        var c = data.comments[i];
        var name = c.user === 'guest' ? (c.body.match(/\*\*(.+?)\*\*/)||['','匿名'])[1] : c.user;
        var text = c.body.replace(/^\*\*.+?\*\* 说：\n\n/, '');
        var time = new Date(c.created_at).toLocaleDateString('zh-CN', { month:'short', day:'numeric', hour:'2-digit', minute:'2-digit' });
        var initial = name.charAt(0).toUpperCase();
        html += '<div class="gc-msg">' +
          '<div class="gc-msg-header">' +
            '<span class="gc-msg-avatar">' + initial + '</span>' +
            '<span class="gc-msg-name">' + esc(name) + '</span>' +
            '<span class="gc-msg-time">' + time + '</span>' +
          '</div>' +
          '<div class="gc-msg-body">' + esc(text) + '</div>' +
        '</div>';
      }
      messages.innerHTML = html;
    }).catch(function(){
      messages.innerHTML = '<p class="gc-empty">加载失败，请刷新试试</p>';
    });
  }

  form.addEventListener('submit', function(e){
    e.preventDefault();
    var text = textEl.value.trim();
    if (!text) return;
    submitBtn.disabled = true;
    hintEl.textContent = '发送中...';
    fetch(API, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: nameEl.value.trim(), text: text }),
    }).then(function(r){ return r.json(); }).then(function(data){
      if (data.ok) {
        textEl.value = '';
        hintEl.textContent = '发送成功！';
        loadComments();
      } else {
        hintEl.textContent = '发送失败：' + (data.error || '请稍后再试');
      }
      submitBtn.disabled = false;
    }).catch(function(){
      hintEl.textContent = '网络错误，请稍后再试';
      submitBtn.disabled = false;
    });
  });

  function esc(s) {
    var d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  loadComments();
})();
</script>
