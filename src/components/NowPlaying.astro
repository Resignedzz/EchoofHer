---
// 网易云音乐 · 桌面宠物播放器 v10
// HTML5 Audio + 网易云音乐外链 · 零依赖
---
<style>
  #np-root { position: fixed; bottom: 16px; right: 16px; z-index: 1000; }
  .np-panel {
    width: 310px;
    background: var(--bg-card, rgba(15,15,20,0.85));
    border: 1px solid var(--border, rgba(255,255,255,0.06));
    backdrop-filter: blur(20px);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    transition: all 0.3s ease;
    transform-origin: bottom right;
  }
  .np-panel.np-hidden { opacity: 0; transform: scale(0.9); pointer-events: none; }
  .np-progress-bar { position: relative; height: 2px; background: var(--border); }
  .np-progress-fill { height: 100%; background: var(--accent, #e0e0f0); border-radius: 1px; width: 0%; transition: width 0.3s linear; }
  .np-mini-bar {
    display: flex; align-items: center; gap: 8px;
    padding: 8px 12px; border-bottom: 1px solid var(--border);
  }
  .np-mini-cover { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; background: var(--border); flex-shrink: 0; }
  .np-mini-info { flex: 1; min-width: 0; }
  .np-mini-name { font-family: var(--font-mono, monospace); font-size: 11px; color: var(--text, #e0e0f0); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .np-mini-artist { font-family: var(--font-mono, monospace); font-size: 9px; color: var(--text-muted, #888); opacity: 0.6; margin-top: 2px; }
  .np-mini-idx { font-family: var(--font-mono, monospace); font-size: 9px; color: var(--text-muted, #888); opacity: 0.3; flex-shrink: 0; }
  .np-tabs { display: flex; border-bottom: 1px solid var(--border); }
  .np-tab {
    flex: 1; padding: 8px 0; text-align: center;
    font-family: var(--font-mono, monospace); font-size: 10px;
    color: var(--text-muted, #888); cursor: pointer;
    border-bottom: 2px solid transparent; transition: all 0.2s;
  }
  .np-tab.np-active { color: var(--accent, #e0e0f0); border-bottom-color: var(--accent, #e0e0f0); }
  .np-tab:hover { color: var(--text, #e0e0f0); }
  .np-tracklist { max-height: 320px; overflow-y: auto; scrollbar-width: thin; scrollbar-color: var(--border) transparent; }
  .np-track-item {
    display: flex; align-items: center; gap: 8px;
    padding: 8px 12px; cursor: pointer; transition: background 0.2s;
  }
  .np-track-item:hover { background: rgba(255,255,255,0.03); }
  .np-track-item.np-playing .np-track-name { color: var(--accent, #8b8ba8); }
  .np-track-num { font-family: var(--font-mono, monospace); font-size: 10px; color: var(--text-muted, #888); opacity: 0.3; width: 20px; text-align: right; flex-shrink: 0; }
  .np-track-name { font-family: var(--font-mono, monospace); font-size: 11px; color: var(--text, #e0e0f0); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .np-track-artist { font-family: var(--font-mono, monospace); font-size: 9px; color: var(--text-muted, #888); opacity: 0.5; margin-top: 2px; }
  .np-lyrics-area { max-height: 320px; overflow-y: auto; padding: 16px; scroll-behavior: smooth; scrollbar-width: thin; scrollbar-color: var(--border) transparent; }
  .np-lyric-line { font-family: var(--font-mono, monospace); font-size: 11px; color: var(--text-muted, #888); opacity: 0.3; padding: 6px 0; text-align: center; transition: all 0.3s; }
  .np-lyric-line.np-active { color: var(--accent, #e0e0f0); opacity: 1; font-size: 12px; }
  .np-lyric-line.np-near { opacity: 0.6; }
  .np-lyric-line.np-empty { opacity: 0.1; }
  .np-controls { display: flex; align-items: center; gap: 6px; padding: 10px 12px; border-top: 1px solid var(--border); }
  .np-btn {
    width: 32px; height: 32px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    color: var(--text-muted, #888); cursor: pointer;
    transition: all 0.2s; background: none; border: none;
  }
  .np-btn:hover { color: var(--accent, #e0e0f0); background: rgba(255,255,255,0.05); }
  .np-btn:active { transform: scale(0.9); }
  .np-count { font-family: var(--font-mono, monospace); font-size: 9px; color: var(--text-muted, #888); opacity: 0.3; margin-left: auto; }

  /* ── Vinyl Circle ── */
  .np-circle {
    position: relative; width: 60px; height: 60px;
    border-radius: 50%; cursor: pointer; flex-shrink: 0;
    background: radial-gradient(circle, #1a1a2e 38%, #111 39%, #111 61%, #0a0a0a 62%);
    box-shadow: 0 0 0 2px rgba(255,255,255,0.05), 0 4px 20px rgba(0,0,0,0.5);
    transition: transform 0.3s;
    overflow: visible;
  }
  .np-circle:hover { transform: scale(1.08); }
  .np-circle-cover {
    position: absolute; top: 50%; left: 50%;
    width: 42%; height: 42%; border-radius: 50%;
    transform: translate(-50%, -50%); object-fit: cover;
    border: 1.5px solid rgba(255,255,255,0.1);
  }
  .np-circle-icon {
    position: absolute; top: 50%; left: 50%;
    width: 18px; height: 18px; transform: translate(-50%, -50%);
    fill: var(--accent, #e0e0f0); opacity: 0.6;
  }
  .np-circle-grooves {
    position: absolute; inset: 0; border-radius: 50%;
    background: repeating-radial-gradient(circle, transparent, transparent 2px, rgba(255,255,255,0.015) 2px, rgba(255,255,255,0.015) 3px);
    pointer-events: none;
  }
  @keyframes np-spin { to { transform: translate(-50%, -50%) rotate(360deg); } }
  .np-spinning .np-circle-cover { animation: np-spin 3s linear infinite; }
  .np-spinning .np-circle-grooves { animation: np-spin 8s linear infinite; }

  /* ── Tooltip ── */
  .np-tooltip {
    position: absolute; bottom: 100%; right: 0;
    padding: 6px 12px; margin-bottom: 8px;
    background: var(--bg-card, rgba(15,15,20,0.9));
    border: 1px solid var(--border, rgba(255,255,255,0.06));
    border-radius: 8px; white-space: nowrap;
    opacity: 0; transform: translateY(4px) scale(0.95);
    transition: all 0.2s; pointer-events: none;
  }
  .np-circle:hover .np-tooltip { opacity: 1; transform: translateY(0) scale(1); }
  .np-tooltip-name { font-family: var(--font-mono, monospace); font-size: 12px; color: var(--text, #e0e0f0); }
  .np-tooltip-artist { font-family: var(--font-mono, monospace); font-size: 10px; color: var(--text-muted, #888); opacity: 0.5; margin-top: 2px; }
  .np-tooltip-divider { height: 1px; background: var(--border); margin: 6px 0; }

  @media (prefers-reduced-motion: reduce) {
    .np-spinning .np-circle-cover, .np-spinning .np-circle-grooves { animation: none; }
    .np-panel, .np-btn, .np-circle, .np-tooltip { transition-duration: 0s; }
  }
</style>

<div id="np-root" class="flex flex-col items-end">
  <!-- Panel -->
  <div id="np-panel" class="np-panel np-hidden mb-2">
    <!-- Progress -->
    <div class="np-progress-bar">
      <div id="np-progress" class="np-progress-fill"></div>
    </div>
    <!-- Mini bar -->
    <div class="np-mini-bar">
      <img id="np-bar-cover" class="np-mini-cover" src="" alt="">
      <div class="np-mini-info">
        <p id="np-bar-name" class="np-mini-name">--</p>
        <p id="np-bar-artist" class="np-mini-artist">--</p>
      </div>
      <span id="np-bar-index" class="np-mini-idx">0/0</span>
    </div>
    <!-- Tabs -->
    <div class="np-tabs">
      <div id="np-tab-list" class="np-tab np-active">Tracklist</div>
      <div id="np-tab-lyrics" class="np-tab">Lyrics</div>
    </div>
    <!-- Track List -->
    <div id="np-tracklist" class="np-tracklist">
      <p style="font-family:monospace;font-size:10px;color:var(--text-muted,#888);opacity:0.3;text-align:center;padding:20px;">loading...</p>
    </div>
    <!-- Lyrics -->
    <div id="np-lyrics-area" class="np-lyrics-area" style="display:none;">
      <div style="height:80px"></div>
      <p style="font-family:monospace;font-size:10px;color:var(--text-muted,#888);opacity:0.3;text-align:center;">no lyrics</p>
    </div>
    <!-- Controls -->
    <div class="np-controls">
      <button id="np-btn-prev" class="np-btn" aria-label="上一曲">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
      </button>
      <div style="flex:1"></div>
      <span id="np-count" class="np-count">0 首</span>
      <div style="flex:1"></div>
      <button id="np-btn-next" class="np-btn" aria-label="下一曲">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M16 6h2v12h-2zm-10 0l8.5 6L6 18z"/></svg>
      </button>
    </div>
  </div>

  <!-- Vinyl Circle -->
  <div id="np-circle" class="np-circle" aria-label="音乐播放器">
    <div class="np-circle-grooves"></div>
    <img id="np-circle-cover" class="np-circle-cover" src="" alt="" style="opacity:0">
    <svg id="np-circle-icon" class="np-circle-icon" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
    <!-- Tooltip -->
    <div class="np-tooltip">
      <p id="np-tip-name" class="np-tooltip-name">我的歌单</p>
      <p id="np-tip-artist" class="np-tooltip-artist">--</p>
      <div class="np-tooltip-divider"></div>
      <p style="font-family:monospace;font-size:9px;color:var(--text-muted,#888);opacity:0.3;text-align:center;">click: play | dblclick: panel</p>
    </div>
  </div>

  <!-- Hidden audio -->
  <audio id="np-audio" preload="none"></audio>
</div>

<script is:inline>
(function(){
  // ── Config ──
  var PLAYLIST_ID = 2953785286;
  var API = '/api/netease';
  var NETEASE_URL = 'https://music.163.com/#/playlist?id=' + PLAYLIST_ID;

  // ── DOM refs ──
  var root = document.getElementById('np-root');
  var panel = document.getElementById('np-panel');
  var circle = document.getElementById('np-circle');
  var audioEl = document.getElementById('np-audio');
  var tipName = document.getElementById('np-tip-name');
  var tipArtist = document.getElementById('np-tip-artist');
  var barCover = document.getElementById('np-bar-cover');
  var barName = document.getElementById('np-bar-name');
  var barArtist = document.getElementById('np-bar-artist');
  var barIndex = document.getElementById('np-bar-index');
  var progressEl = document.getElementById('np-progress');
  var tabList = document.getElementById('np-tab-list');
  var tabLyrics = document.getElementById('np-tab-lyrics');
  var tracklistEl = document.getElementById('np-tracklist');
  var lyricsArea = document.getElementById('np-lyrics-area');
  var btnPrev = document.getElementById('np-btn-prev');
  var btnNext = document.getElementById('np-btn-next');
  var countEl = document.getElementById('np-count');
  var circleCover = document.getElementById('np-circle-cover');
  var circleIcon = document.getElementById('np-circle-icon');

  if (!panel || !circle || !audioEl) return;

  // ── State ──
  var tracks = [];
  var currentIdx = 0;
  var hasTracks = false;
  var panelOpen = false;
  var isPlaying = false;
  var coverUrl = '';
  var playlistName = '我的歌单';

  // ── Format duration ──
  function fmt(ms) {
    var s = Math.floor(ms / 1000);
    var m = Math.floor(s / 60);
    return m + ':' + String(s % 60).padStart(2, '0');
  }

  // ── Play track ──
  function playTrack(idx) {
    if (!hasTracks || !tracks[idx]) return;
    currentIdx = idx;
    var t = tracks[idx];

    barName.textContent = t.name;
    barArtist.textContent = t.artist;
    barIndex.textContent = (idx + 1) + '/' + tracks.length;
    tipName.textContent = t.name;
    tipArtist.textContent = t.artist;

    if (t.cover) {
      barCover.src = t.cover;
      circleCover.src = t.cover;
      circleCover.style.opacity = '1';
      circleIcon.style.opacity = '0';
    }

    // Try to play via netease url
    var src = 'https://music.163.com/song/media/outer/url?id=' + t.id + '.mp3';
    audioEl.src = src;
    var p = audioEl.play();
    if (p && p.catch) p.catch(function(){});
    isPlaying = true;
    circle.classList.add('np-spinning');

    // Update tracklist highlight
    var items = tracklistEl.querySelectorAll('.np-track-item');
    for (var i = 0; i < items.length; i++) {
      items[i].classList.toggle('np-playing', i === idx);
    }

    // Render lyrics
    renderLyrics(t.lyrics || []);
  }

  // ── Render track list ──
  function renderTrackList() {
    if (!tracklistEl) return;
    tracklistEl.innerHTML = '';
    if (!tracks.length) {
      tracklistEl.innerHTML = '<p style="font-family:monospace;font-size:10px;color:var(--text-muted,#888);opacity:0.3;text-align:center;padding:20px;">暂无歌曲</p>';
      return;
    }
    var ul = document.createElement('ul');
    ul.style.cssText = 'list-style:none;margin:0;padding:0;border-bottom:1px solid var(--border,rgba(255,255,255,0.06))';
    for (var i = 0; i < tracks.length; i++) {
      (function(idx){
        var t = tracks[idx];
        var li = document.createElement('li');
        li.className = 'np-track-item';
        if (idx === currentIdx) li.classList.add('np-playing');
        li.style.cssText = 'border-bottom:1px solid var(--border,rgba(255,255,255,0.06))';
        li.innerHTML =
          '<span class="np-track-num">' + String(idx + 1).padStart(2, '0') + '</span>' +
          '<div style="flex:1;min-width:0">' +
            '<p class="np-track-name">' + t.name + '</p>' +
            '<p class="np-track-artist">' + t.artist + '</p>' +
          '</div>' +
          '<span style="font-family:monospace;font-size:9px;color:var(--text-muted,#888);opacity:0.2;flex-shrink:0">' + fmt(t.duration) + '</span>';
        li.addEventListener('click', function(e) {
          e.stopPropagation();
          playTrack(idx);
        });
        ul.appendChild(li);
      })(i);
    }
    tracklistEl.appendChild(ul);
    countEl.textContent = tracks.length + ' 首';
  }

  // ── Render lyrics ──
  function renderLyrics(lines) {
    lyricsArea.innerHTML = '<div style="height:80px"></div>';
    if (!lines || !lines.length) {
      lyricsArea.innerHTML += '<p style="font-family:monospace;font-size:10px;color:var(--text-muted,#888);opacity:0.3;text-align:center;">暂无歌词</p>';
      return;
    }
    for (var i = 0; i < lines.length; i++) {
      var p = document.createElement('p');
      p.className = 'np-lyric-line';
      p.dataset.time = lines[i].time;
      p.textContent = lines[i].text || '...';
      lyricsArea.appendChild(p);
    }
    lyricsArea.innerHTML += '<div style="height:80px"></div>';
  }

  // ── Switch tab ──
  function switchTab(tab) {
    tabList.classList.toggle('np-active', tab === 'list');
    tabLyrics.classList.toggle('np-active', tab === 'lyrics');
    tracklistEl.style.display = tab === 'list' ? '' : 'none';
    lyricsArea.style.display = tab === 'lyrics' ? '' : 'none';
  }

  // ── Toggle panel ──
  function togglePanel() {
    panelOpen = !panelOpen;
    panel.classList.toggle('np-hidden', !panelOpen);
  }

  // ── Load playlist ──
  async function loadPlaylist() {
    try {
      var res = await fetch(API + '?type=playlist&id=' + PLAYLIST_ID);
      if (!res.ok) throw new Error('API ' + res.status);
      var data = await res.json();
      var pl = data.playlist;
      if (!pl || !pl.tracks) throw new Error('no playlist data');

      coverUrl = (pl.coverImgUrl || '').replace('http:', 'https:') + '?param=200y200';
      playlistName = '我的' + (pl.name || '歌单');

      var raw = pl.tracks || [];
      tracks = [];
      for (var i = 0; i < raw.length && i < 50; i++) {
        var r = raw[i];
        tracks.push({
          id: r.id || 0,
          name: r.name || '',
          artist: (r.ar || []).map(function(a){ return a.name; }).join(', '),
          cover: ((r.al || {}).picUrl || '').replace('http:', 'https:') + '?param=200y200',
          duration: r.dt || 200000,
          lyrics: []
        });
      }
      hasTracks = tracks.length > 0;

    } catch(e) {
      console.warn('NowPlaying: using fallback', e);
      tracks = [
        { id: 186016, name: '晴天', artist: '周杰伦', cover: 'https://p1.music.126.net/lKrT6cT3dNn2U86eOzBK3A==/109951163753563246.jpg?param=200y200', duration: 269000, lyrics: [] },
        { id: 1901371647, name: '起风了', artist: '买辣椒也用券', cover: '', duration: 325000, lyrics: [] },
        { id: 1397345903, name: '星际穿越', artist: 'Hans Zimmer', cover: '', duration: 236000, lyrics: [] },
      ];
      hasTracks = true;
      playlistName = 'Demo 歌单';
      coverUrl = tracks[0].cover;
    }

    if (hasTracks) {
      tipName.textContent = tracks[0].name;
      tipArtist.textContent = tracks[0].artist;
      if (coverUrl) {
        barCover.src = coverUrl;
        circleCover.src = coverUrl;
        circleCover.style.opacity = '1';
        circleIcon.style.opacity = '0';
      }
    }
    countEl.textContent = tracks.length + ' 首';
    renderTrackList();
  }

  // ── Audio events ──
  audioEl.addEventListener('timeupdate', function() {
    if (!audioEl.duration) return;
    var pct = (audioEl.currentTime / audioEl.duration) * 100;
    progressEl.style.width = pct + '%';
  });
  audioEl.addEventListener('ended', function() {
    isPlaying = false;
    circle.classList.remove('np-spinning');
    if (hasTracks) {
      playTrack((currentIdx + 1) % tracks.length);
    }
  });
  audioEl.addEventListener('pause', function() {
    isPlaying = false;
    circle.classList.remove('np-spinning');
  });

  // ── Event bindings ──
  circle.addEventListener('click', function(e) {
    if (e.detail && e.detail >= 2) return; // let dblclick handle
    if (!hasTracks) return;
    if (isPlaying) {
      audioEl.pause();
    } else {
      playTrack(currentIdx);
    }
  });
  circle.addEventListener('dblclick', function(e) {
    e.preventDefault();
    togglePanel();
  });
  btnPrev.addEventListener('click', function() {
    if (hasTracks) playTrack((currentIdx - 1 + tracks.length) % tracks.length);
  });
  btnNext.addEventListener('click', function() {
    if (hasTracks) playTrack((currentIdx + 1) % tracks.length);
  });
  tabList.addEventListener('click', function() { switchTab('list'); });
  tabLyrics.addEventListener('click', function() { switchTab('lyrics'); });

  // ── Reduced motion ──
  if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    var st = document.createElement('style');
    st.textContent = '#np-root * { animation-duration:0s!important;transition-duration:0s!important; }';
    document.head.appendChild(st);
  }

  // ── Init ──
  loadPlaylist();
})();
</script>
