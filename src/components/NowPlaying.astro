---
// 网易云音乐 · 两态黑胶唱片播放器 v11
// <audio> 服务端代理 + 两态 UI
// 需要 astro dev 或 Cloudflare Pages 部署才能播放音频
// 静态 serve 时 fallback 歌曲可显示但无法播放
---
<style is:inline>
  #np-root{position:fixed;bottom:16px;right:16px;z-index:1000;font-family:var(--font-mono,monospace)}

  /* ── Mini Vinyl ── */
  .np-mini{position:relative;width:40px;height:40px;border-radius:50%;cursor:pointer;
    background:radial-gradient(circle,#1a1a2e 38%,#111 39%,#111 61%,#0a0a0a 62%);
    box-shadow:0 0 0 1.5px rgba(255,255,255,.06),0 2px 12px rgba(0,0,0,.5);
    transition:transform .25s;overflow:hidden}
  .np-mini:hover{transform:scale(1.12)}
  .np-grooves{position:absolute;inset:0;border-radius:50%;pointer-events:none;
    background:repeating-radial-gradient(circle,transparent,transparent 1.5px,rgba(255,255,255,.012) 1.5px,rgba(255,255,255,.012) 2.5px)}
  .np-m-cover{position:absolute;top:50%;left:50%;width:40%;height:40%;border-radius:50%;
    transform:translate(-50%,-50%);object-fit:cover;border:1px solid rgba(255,255,255,.08);
    opacity:0;transition:opacity .3s}
  .np-m-cover.on{opacity:1}
  .np-m-icon{position:absolute;top:50%;left:50%;width:12px;height:12px;
    transform:translate(-50%,-50%);fill:var(--accent,#e0e0f0);opacity:.5;transition:opacity .3s}
  .np-m-icon.off{opacity:0}
  @keyframes np-spin{to{transform:translate(-50%,-50%) rotate(360deg)}}
  .np-spin .np-m-cover{animation:np-spin 3s linear infinite}
  .np-spin .np-grooves{animation:np-spin 8s linear infinite}

  /* ── Pulse ── */
  .np-pulse{position:absolute;top:-2px;right:-2px;width:10px;height:10px;
    pointer-events:none;opacity:0;transition:opacity .3s}
  .np-pd{position:absolute;inset:0;border-radius:50%;background:#22c55e;box-shadow:0 0 4px #22c55e}
  .np-pr{position:absolute;inset:-3px;border-radius:50%;border:1.5px solid #22c55e;opacity:0}
  .np-spin .np-pulse{opacity:1}
  .np-spin .np-pr{animation:np-ping 1.5s ease-out infinite}
  @keyframes np-ping{0%{transform:scale(.6);opacity:.8}100%{transform:scale(1.8);opacity:0}}

  /* ── Glow ── */
  .np-glow{position:absolute;inset:-4px;border-radius:50%;pointer-events:none;
    opacity:0;transition:opacity .4s;
    background:radial-gradient(circle,rgba(120,100,255,.15),transparent 70%)}
  .np-spin .np-glow{opacity:1}

  /* ── Tooltip ── */
  .np-tip{position:absolute;bottom:calc(100% + 10px);right:0;padding:5px 10px;white-space:nowrap;
    background:var(--bg-card,rgba(15,15,20,.92));border:1px solid var(--border,rgba(255,255,255,.06));
    border-radius:6px;backdrop-filter:blur(12px);opacity:0;transform:translateY(4px);
    transition:all .2s;pointer-events:none;box-shadow:0 4px 16px rgba(0,0,0,.3)}
  .np-mini:hover .np-tip{opacity:1;transform:translateY(0)}
  .np-tip b{font-size:11px;line-height:1.2;color:var(--text,#e0e0f0);font-weight:400}
  .np-tip small{display:block;font-size:9px;line-height:1.2;color:var(--text-muted,#888);opacity:.5;margin-top:2px}

  /* ── Panel ── */
  .np-panel{position:absolute;bottom:52px;right:0;width:310px;max-height:420px;display:flex;flex-direction:column;
    background:var(--bg-card,rgba(15,15,20,.85));border:1px solid var(--border,rgba(255,255,255,.06));
    backdrop-filter:blur(20px);border-radius:12px;overflow:hidden;
    box-shadow:0 8px 32px rgba(0,0,0,.4);transform-origin:bottom right;
    opacity:0;transform:scale(.92) translateY(8px);pointer-events:none;transition:all .3s}
  .np-panel.open{opacity:1;transform:scale(1) translateY(0);pointer-events:auto}

  /* ── Header ── */
  .np-hd{display:flex;align-items:center;gap:8px;padding:10px 12px;border-bottom:1px solid var(--border)}
  .np-dot{width:6px;height:6px;border-radius:50%;background:#555;flex-shrink:0;transition:background .3s}
  .np-dot.live{background:#22c55e;box-shadow:0 0 6px #22c55e}
  .np-hd-title{flex:1;font-size:10px;color:var(--text-muted,#888);opacity:.5;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .np-hd-count{font-size:9px;color:var(--text-muted,#888);opacity:.25;flex-shrink:0}
  .np-hd-link{font-size:11px;color:var(--text-muted,#888);opacity:.3;text-decoration:none;
    transition:opacity .2s;display:flex;align-items:center}
  .np-hd-link:hover{opacity:.7}

  /* ── Tabs ── */
  .np-tabs{display:flex;border-bottom:1px solid var(--border)}
  .np-tab{flex:1;padding:7px 0;text-align:center;cursor:pointer;font-size:10px;line-height:1;
    color:var(--text-muted,#888);border-bottom:2px solid transparent;transition:all .2s}
  .np-tab:hover{color:var(--text,#e0e0f0)}
  .np-tab.on{color:var(--accent,#e0e0f0);border-bottom-color:var(--accent,#e0e0f0)}

  /* ── Now-playing bar ── */
  .np-np{display:flex;align-items:center;gap:8px;padding:8px 12px;border-bottom:1px solid var(--border);
    background:rgba(255,255,255,.015)}
  .np-np-cover{width:36px;height:36px;border-radius:50%;object-fit:cover;flex-shrink:0;
    border:1px solid rgba(255,255,255,.06);transition:transform .2s;cursor:pointer}
  .np-np-cover:hover{transform:scale(1.06)}
  .np-np-cover.spin{animation:np-spin 3s linear infinite}
  .np-np-info{flex:1;min-width:0}
  .np-np-name{font-size:11px;line-height:1.3;color:var(--text,#e0e0f0);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .np-np-artist{font-size:9px;line-height:1.2;color:var(--text-muted,#888);opacity:.5;margin-top:1px}
  .np-np-idx{font-size:9px;color:var(--text-muted,#888);opacity:.2;flex-shrink:0}

  /* ── Progress bar ── */
  .np-bar{padding:0 12px;height:20px;display:flex;align-items:center;gap:8px;border-bottom:1px solid var(--border)}
  .np-time{font-size:9px;color:var(--text-muted,#888);opacity:.3;min-width:32px;text-align:center}
  .np-track{flex:1;height:3px;background:rgba(255,255,255,.06);border-radius:2px;cursor:pointer;position:relative;overflow:hidden}
  .np-fill{height:100%;background:var(--accent-secondary,#8b8ba8);border-radius:2px;width:0;transition:width .15s linear}

  /* ── Track list ── */
  .np-list{flex:1;overflow-y:auto;scrollbar-width:thin;scrollbar-color:var(--border) transparent}
  .np-item{display:flex;align-items:center;gap:8px;padding:6px 12px;cursor:pointer;
    transition:background .15s;border-bottom:1px solid var(--border)}
  .np-item:last-child{border-bottom:none}
  .np-item:hover{background:rgba(255,255,255,.025)}
  .np-item.cur .np-item-name{color:var(--accent-secondary,#8b8ba8)}
  .np-item-cover{width:28px;height:28px;border-radius:50%;object-fit:cover;flex-shrink:0;
    border:1px solid rgba(255,255,255,.04)}
  .np-item-info{flex:1;min-width:0}
  .np-item-name{font-size:11px;line-height:1.3;color:var(--text,#e0e0f0);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .np-item-artist{font-size:9px;line-height:1.2;color:var(--text-muted,#888);opacity:.4;margin-top:1px}
  .np-item-dur{font-size:9px;color:var(--text-muted,#888);opacity:.18;flex-shrink:0}

  /* ── Lyrics ── */
  .np-lrcs{flex:1;overflow-y:auto;padding:16px;scroll-behavior:smooth;
    scrollbar-width:thin;scrollbar-color:var(--border) transparent}
  .np-lrc{font-size:11px;line-height:1.8;color:var(--text-muted,#888);opacity:.2;text-align:center;padding:2px 0;
    transition:all .3s}
  .np-lrc.cur{color:var(--accent,#e0e0f0);opacity:1;font-size:12px}
  .np-lrc.near{opacity:.5}

  /* ── Controls ── */
  .np-ctrl{display:flex;align-items:center;gap:4px;padding:8px 16px;border-top:1px solid var(--border)}
  .np-btn{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;
    color:var(--text-muted,#888);cursor:pointer;background:none;border:none;transition:all .15s}
  .np-btn:hover{color:var(--accent,#e0e0f0);background:rgba(255,255,255,.04)}
  .np-btn:active{transform:scale(.9)}
  .np-btn svg{width:14px;height:14px;fill:currentColor}

  /* ── Empty ── */
  .np-empty{font-size:10px;color:var(--text-muted,#888);opacity:.25;text-align:center;padding:24px 0}

  @media(prefers-reduced-motion:reduce){
    .np-spin *,.np-np-cover.spin{animation:none!important}
    .np-spin .np-pr{animation:none!important}
    #np-root *{transition-duration:0s!important}
  }
</style>

<div id="np-root">
  <!-- Panel -->
  <div id="np-panel" class="np-panel">
    <!-- Header -->
    <div class="np-hd">
      <div id="np-dot" class="np-dot"></div>
      <span id="np-hd-title" class="np-hd-title">我的歌单</span>
      <span id="np-hd-count" class="np-hd-count">0</span>
      <a id="np-link" class="np-hd-link" href="https://music.163.com/#/playlist?id=2953785286" target="_blank" rel="noopener" title="在网易云打开">↗</a>
    </div>
    <!-- Tabs -->
    <div class="np-tabs">
      <div id="np-t-list" class="np-tab on">歌曲</div>
      <div id="np-t-lrc" class="np-tab">歌词</div>
    </div>
    <!-- Now-playing bar -->
    <div id="np-np" class="np-np">
      <img id="np-np-cover" class="np-np-cover" src="" alt="" width="36" height="36" onerror="this.style.display='none'">
      <div class="np-np-info">
        <p id="np-np-name" class="np-np-name">--</p>
        <p id="np-np-artist" class="np-np-artist">--</p>
      </div>
      <span id="np-np-idx" class="np-np-idx">-/-</span>
    </div>
    <!-- Progress bar -->
    <div class="np-bar">
      <span id="np-cur-t" class="np-time">0:00</span>
      <div id="np-track" class="np-track">
        <div id="np-fill" class="np-fill"></div>
      </div>
      <span id="np-dur-t" class="np-time">0:00</span>
    </div>
    <!-- Track list -->
    <div id="np-list" class="np-list"><p class="np-empty">loading...</p></div>
    <!-- Lyrics -->
    <div id="np-lrcs" class="np-lrcs" style="display:none"><div style="height:60px"></div><p class="np-empty">暂无歌词</p></div>
    <!-- Controls -->
    <div class="np-ctrl">
      <button id="np-b-prev" class="np-btn" aria-label="上一曲"><svg viewBox="0 0 24 24"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg></button>
      <div style="flex:1"></div>
      <button id="np-b-next" class="np-btn" aria-label="下一曲"><svg viewBox="0 0 24 24"><path d="M16 6h2v12h-2zm-10 0l8.5 6L6 18z"/></svg></button>
    </div>
  </div>

  <!-- Mini Vinyl -->
  <div id="np-mini" class="np-mini">
    <div class="np-glow"></div>
    <div class="np-grooves"></div>
    <img id="np-m-cover" class="np-m-cover" src="" alt="" width="16" height="16" onerror="this.style.display='none'">
    <svg id="np-m-icon" class="np-m-icon" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
    <div class="np-pulse"><div class="np-pd"></div><div class="np-pr"></div></div>
    <div class="np-tip">
      <b id="np-tip-name">我的歌单</b>
      <small id="np-tip-artist">--</small>
    </div>
    <!-- Audio element (hidden) -->
    <audio id="np-audio" preload="auto" crossorigin="anonymous" style="position:absolute;bottom:-100px;right:0;width:1px;height:1px;opacity:0;pointer-events:none"></audio>
  </div>
</div>

<script is:inline>
(function(){
  var PL_ID = 2953785286, API = '/api/netease';

  // DOM
  var $ = function(id){ return document.getElementById(id); };
  var mini=$('np-mini'), panel=$('np-panel');
  var dot=$('np-dot'), hdTitle=$('np-hd-title'), hdCount=$('np-hd-count');
  var npCover=$('np-np-cover'), npName=$('np-np-name'), npArtist=$('np-np-artist'), npIdx=$('np-np-idx');
  var mCover=$('np-m-cover'), mIcon=$('np-m-icon');
  var tipName=$('np-tip-name'), tipArtist=$('np-tip-artist');
  var listEl=$('np-list'), lrcsEl=$('np-lrcs');
  var tList=$('np-t-list'), tLrc=$('np-t-lrc');
  var bPrev=$('np-b-prev'), bNext=$('np-b-next');
  var audio=$('np-audio');
  var fillEl=$('np-fill'), curT=$('np-cur-t'), durT=$('np-dur-t'), trackEl=$('np-track');

  if (!mini||!panel||!audio) return;

  // State
  var tracks=[], cur=-1, open=false, playing=false;
  var closeTimer=null, lrcLines=[];

  function fmt(ms){
    var s=Math.floor(ms/1000),m=Math.floor(s/60);
    return m+':'+String(s%60).padStart(2,'0');
  }

  function setCover(url){
    if (!url) return;
    npCover.src=url; mCover.src=url;
    mCover.classList.add('on'); mIcon.classList.add('off');
  }

  function updateUI(idx){
    if (idx<0||idx>=tracks.length) return;
    var t=tracks[idx];
    npName.textContent=t.name; npArtist.textContent=t.artist;
    npIdx.textContent=(idx+1)+'/'+tracks.length;
    tipName.textContent=t.name; tipArtist.textContent=t.artist;
    if (t.cover) setCover(t.cover);
    // highlight
    var items=listEl.querySelectorAll('.np-item');
    for(var i=0;i<items.length;i++) items[i].classList.toggle('cur',i===idx);
    dot.classList.add('live');
  }

  function setSpin(on){
    playing=on;
    if(on){
      mini.classList.add('np-spin');
      npCover.classList.add('spin');
    } else {
      mini.classList.remove('np-spin');
      npCover.classList.remove('spin');
    }
  }

  function setAudioSrc(songId){
    // Server proxy: fetches real URL server-side and 302 redirects
    audio.src = API + '?type=song-url&id=' + songId;
  }

  // ── Parse LRC lyrics ──
  function parseLrc(lrcText){
    if(!lrcText) return [];
    var lines=[], re=/\[(\d{2}):(\d{2})[\.:](\d{2,3})\](.+)/g, m;
    while(m=re.exec(lrcText)){
      var time=parseInt(m[1])*60+parseInt(m[2])+parseInt(m[3])/(m[3].length===3?1000:100);
      var text=m[4].trim();
      if(text) lines.push({time:time,text:text});
    }
    return lines.sort(function(a,b){return a.time-b.time});
  }

  // ── Fetch lyrics for a track ──
  async function fetchLyrics(trackId,trackIdx){
    try{
      var res=await fetch(API+'?type=lyric&id='+trackId);
      if(!res.ok) return;
      var data=await res.json();
      var lrc=data.lrc?data.lrc.lyric:'';
      var parsed=parseLrc(lrc);
      if(trackIdx>=0&&trackIdx<tracks.length){
        tracks[trackIdx].lyrics=parsed;
        if(trackIdx===cur) renderLyrics(parsed);
      }
    }catch(e){console.warn('[NP] lyric fetch fail:',e)}
  }

  function play(idx){
    if (idx<0||idx>=tracks.length) return;
    cur=idx; updateUI(idx);
    setAudioSrc(tracks[idx].id);
    audio.play().catch(function(e){
      console.warn('[NP] play blocked:', e.message);
    });
    setSpin(true);
    // lyrics
    if(tracks[idx].lyrics&&tracks[idx].lyrics.length){
      renderLyrics(tracks[idx].lyrics);
    } else {
      fetchLyrics(tracks[idx].id, idx);
    }
  }

  function next(){ if(tracks.length) play((cur+1)%tracks.length); }
  function prev(){ if(tracks.length) play((cur-1+tracks.length)%tracks.length); }

  function togglePanel(){
    open=!open;
    panel.classList.toggle('open',open);
    if(open){clearTimeout(closeTimer);closeTimer=null}
  }
  function closePanel(){ if(!open)return; open=false; panel.classList.remove('open'); }

  // ── Progress update ──
  function updateProgress(){
    if(!audio.duration||isNaN(audio.duration)) return;
    var pct = (audio.currentTime/audio.duration)*100;
    fillEl.style.width = pct+'%';
    curT.textContent = fmt(audio.currentTime*1000);
    durT.textContent = fmt(audio.duration*1000);
  }

  // ── Audio events ──
  audio.addEventListener('timeupdate', updateProgress);
  audio.addEventListener('ended', function(){ next(); });
  audio.addEventListener('play', function(){ setSpin(true); });
  audio.addEventListener('pause', function(){ setSpin(false); });
  audio.addEventListener('error', function(){
    console.warn('[NP] audio error for track', tracks[cur] ? tracks[cur].name : '?');
    // Don't kill animation — keep visual spin even if audio fails
    // setSpin(false);
  });

  // Seek on track click
  trackEl.addEventListener('click', function(e){
    if(!audio.duration||isNaN(audio.duration)) return;
    var rect=trackEl.getBoundingClientRect();
    var pct=(e.clientX-rect.left)/rect.width;
    pct=Math.max(0,Math.min(1,pct));
    audio.currentTime=pct*audio.duration;
  });

  // ── Render list ──
  function renderList(){
    listEl.innerHTML='';
    if(!tracks.length){listEl.innerHTML='<p class="np-empty">暂无歌曲</p>';return}
    for(var i=0;i<tracks.length;i++){
      (function(idx){
        var t=tracks[idx], el=document.createElement('div');
        el.className='np-item'+(idx===cur?' cur':'');
        el.innerHTML=
          '<img class="np-item-cover" src="'+(t.cover||'')+'" alt="" width="28" height="28" onerror="this.style.display=\'none\'">'+
          '<div class="np-item-info"><p class="np-item-name">'+t.name+'</p><p class="np-item-artist">'+t.artist+'</p></div>'+
          '<span class="np-item-dur">'+fmt(t.duration)+'</span>';
        el.addEventListener('click',function(e){ e.stopPropagation(); play(idx); });
        listEl.appendChild(el);
      })(i);
    }
    hdCount.textContent=tracks.length+' 首';
  }

  // ── Render lyrics ──
  function renderLyrics(lines){
    lrcLines=lines||[];
    lrcsEl.innerHTML='<div style="height:60px"></div>';
    if(!lrcLines.length){lrcsEl.innerHTML+='<p class="np-empty">暂无歌词</p>';lrcsEl.innerHTML+='<div style="height:60px"></div>';return}
    for(var i=0;i<lrcLines.length;i++){
      var p=document.createElement('p');
      p.className='np-lrc'; p.dataset.time=lrcLines[i].time;
      p.textContent=lrcLines[i].text||'...';
      lrcsEl.appendChild(p);
    }
    lrcsEl.innerHTML+='<div style="height:60px"></div>';
  }

  function syncLyrics(){
    if(!lrcLines.length||cur<0||!playing||!audio.duration) return;
    var elapsed=audio.currentTime;
    var ps=lrcsEl.querySelectorAll('.np-lrc');
    var curIdx=-1;
    for(var i=lrcLines.length-1;i>=0;i--){
      if(elapsed>=lrcLines[i].time){curIdx=i;break}
    }
    for(var j=0;j<ps.length;j++){
      var d=Math.abs(j-curIdx);
      ps[j].classList.remove('cur','near');
      if(d===0) ps[j].classList.add('cur');
      else if(d===1) ps[j].classList.add('near');
    }
    if(curIdx>=0&&ps[curIdx]){
      var container=lrcsEl, scrollTarget=ps[curIdx].offsetTop-container.clientHeight/2+container.clientHeight/2;
      container.scrollTop=scrollTarget;
    }
    requestAnimationFrame(syncLyrics);
  }

  function switchTab(tab){
    tList.classList.toggle('on',tab==='list');
    tLrc.classList.toggle('on',tab==='lrc');
    listEl.style.display=tab==='list'?'':'none';
    lrcsEl.style.display=tab==='lrc'?'':'none';
    if(tab==='lrc'&&playing) syncLyrics();
  }

  // ── Load ──
  var MAX_TRACKS = 100;

  async function fetchSongDetails(idList){
    // Batch fetch song details, 100 per request
    var all = [];
    var chunkSize = 100;
    for(var c=0; c<idList.length; c+=chunkSize){
      var chunk = idList.slice(c, c+chunkSize);
      try{
        var idsStr = JSON.stringify(chunk);
        var r = await fetch(API+'?type=song-detail&ids='+encodeURIComponent(idsStr));
        if(!r.ok) continue;
        var d = await r.json();
        var songs = d.songs || [];
        for(var s=0; s<songs.length; s++) all.push(songs[s]);
      }catch(e){console.warn('[NP] song-detail batch fail:',e)}
    }
    return all;
  }

  async function load(){
    try{
      var res=await fetch(API+'?type=playlist&id='+PL_ID);
      if(!res.ok) throw new Error(res.status);
      var data=await res.json(), pl=data.playlist;
      if(!pl||!pl.trackIds) throw new Error('no data');
      hdTitle.textContent=(pl.name||'歌单')+' · '+(pl.creator?pl.creator.nickname||'':'');

      // Get all track IDs (up to MAX_TRACKS)
      var allIds=pl.trackIds||[], idSlice=[];
      for(var k=0; k<allIds.length && k<MAX_TRACKS; k++) idSlice.push(allIds[k].id);

      if(idSlice.length===0) throw new Error('empty ids');

      // Batch fetch song details
      var raw=await fetchSongDetails(idSlice);
      tracks=[];
      for(var i=0;i<raw.length&&i<MAX_TRACKS;i++){
        var r=raw[i];
        tracks.push({id:r.id||0,name:r.name||'',
          artist:(r.ar||[]).map(function(a){return a.name}).join(', '),
          cover:((r.al||{}).picUrl||'').replace('http:','https:')+'?param=100y100',
          duration:r.dt||200000,lyrics:[]});
      }
      if(tracks.length){ setCover(tracks[0].cover); tipName.textContent=tracks[0].name; tipArtist.textContent=tracks[0].artist; }
    }catch(e){
      console.warn('[NP] fallback:',e);
