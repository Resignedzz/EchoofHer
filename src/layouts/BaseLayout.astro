---
import NowPlaying from '../components/NowPlaying.astro';
import ScrollTop from '../components/ScrollTop.astro';
import ParticleTrail from '../components/ParticleTrail.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = 'A personal blog by resigned', ogImage = 'https://echoofher.pages.dev/favicon.svg' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-CN" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/rss.xml" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />

    <!-- KaTeX math rendering -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050507" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
  </head>
  <body class="min-h-screen flex flex-col">
    <ParticleTrail />
    <slot />

    <!-- Cursor glow effect -->
    <div id="cursor-glow" class="pointer-events-none fixed w-[300px] h-[300px] rounded-full -translate-x-1/2 -translate-y-1/2 z-0 opacity-0 transition-opacity duration-500" style="background: radial-gradient(circle, rgba(120,100,220,0.06) 0%, rgba(100,80,200,0.03) 40%, transparent 70%);"></div>

    <!-- Music player -->
    <div class="fixed bottom-5 left-5 z-50">
      <NowPlaying playlistId={2953785286} />
    </div>

    <ScrollTop />
  </body>

  <script is:inline>
    // Code block enhancements: language label + copy button + line numbers (prose-custom only)
    (function () {
      document.querySelectorAll('.prose-custom pre').forEach((pre) => {
        if (pre.dataset.codeEnhanced) return;
        pre.dataset.codeEnhanced = '1';

        const code = pre.querySelector('code');
        const text = code ? code.innerText : pre.innerText;
        const lineCount = text.replace(/\n$/, '').split('\n').length;

        // Astro/Shiki exposes the fence language on <pre data-language="...">;
        // fall back to a language-xxx class on <code>, then "text".
        const lang = pre.dataset.language
          || (code && code.className.match(/language-([\w+-]+)/))?.[1]
          || 'text';

        // Shiki sets overflow-x:auto inline on the pre. Neutralise it so the
        // inner <code> becomes the scroll container — keeping the fixed
        // toolbar/gutter from drifting when long lines scroll horizontally.
        pre.style.overflowX = 'visible';

        // Toolbar: language label (left) + copy button (right).
        const toolbar = document.createElement('div');
        toolbar.className = 'code-toolbar';

        const langSpan = document.createElement('span');
        langSpan.className = 'code-lang';
        langSpan.textContent = lang.toUpperCase();
        toolbar.appendChild(langSpan);

        const btn = document.createElement('button');
        btn.className = 'copy-btn';
        btn.type = 'button';
        btn.setAttribute('aria-label', '复制代码块');
        btn.textContent = '复制';
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(text);
            btn.textContent = '已复制';
            btn.classList.add('copied');
          } catch {
            // Fallback for insecure contexts (e.g. file://)
            const ta = document.createElement('textarea');
            ta.value = text; document.body.appendChild(ta); ta.select();
            document.execCommand('copy'); document.body.removeChild(ta);
            btn.textContent = '已复制'; btn.classList.add('copied');
          }
          setTimeout(() => { btn.textContent = '复制'; btn.classList.remove('copied'); }, 1800);
        });
        toolbar.appendChild(btn);
        pre.appendChild(toolbar);
        pre.classList.add('has-toolbar');

        // Line-number gutter — skip single-line snippets.
        if (lineCount > 1) {
          pre.classList.add('has-lines');
          const gutter = document.createElement('div');
          gutter.className = 'line-gutter';
          gutter.setAttribute('aria-hidden', 'true');
          let html = '';
          for (let i = 1; i <= lineCount; i++) html += '<span>' + i + '</span>';
          gutter.innerHTML = html;
          pre.appendChild(gutter);
        }
      });
    })();

    // Cursor glow - subtle light following mouse
    const glow = document.getElementById('cursor-glow');
    let mouseX = 0, mouseY = 0, glowX = 0, glowY = 0;
    let isVisible = false;

    document.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      if (!isVisible) {
        glow.style.opacity = '1';
        isVisible = true;
      }
    });

    document.addEventListener('mouseleave', () => {
      glow.style.opacity = '0';
      isVisible = false;
    });

    // Smooth follow with requestAnimationFrame
    function animateGlow() {
      glowX += (mouseX - glowX) * 0.08;
      glowY += (mouseY - glowY) * 0.08;
      if (glow) {
        glow.style.left = glowX + 'px';
        glow.style.top = glowY + 'px';
      }
      requestAnimationFrame(animateGlow);
    }
    animateGlow();

    // Respect reduced motion
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      glow?.remove();
    }
  </script>
</html>
